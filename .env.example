# Frontend settings for your own Supabase instance.
# Copy this file to .env.local and replace these values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Do not place Gemini, Pinterest, or Supabase service-role secrets here.

# Optional public HTTPS catalogue endpoint (no API keys, tokens or credentials).
# Native builds should use a hosted endpoint so prices can refresh without an app update.
# VITE_SHOP_CATALOGUE_URL=https://your-catalogue-host.example/affiliate-catalogue.json
